# データベース接続情報（Supabase）
DATABASE_URL=postgresql://user:password@host:5432/database

# JWT認証
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production

# サーバー設定
PORT=5000
NODE_ENV=development

# Meta広告API（後で設定）
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# 予約システムAPI（後で設定）
BOOKING_API_URL=
BOOKING_API_KEY=

# 自動実行設定
AUTO_FETCH_ENABLED=true
AUTO_FETCH_TIME=0 9 * * * # 毎朝9時（cron形式）
